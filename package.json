{
  "name": "uivolve-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bun scripts/build.mjs",
    "build": "bun run build:wasm && vp build",
    "dev": "bun run build:wasm && vp dev",
    "preview": "vp preview",
    "demo:rpc": "bun scripts/rpc-server.mjs",
    "measure:rpc": "bun scripts/measure-rpc.mjs",
    "publish:packages": "bun scripts/publish-packages.mjs",
    "test:rust": "cargo test --manifest-path engine/Cargo.toml",
    "test": "bun run build:wasm && vp test run && bun run test:rust",
    "check": "vp check && cargo fmt --manifest-path engine/Cargo.toml -- --check",
    "docs:check": "bun scripts/check-docs.mjs",
    "fmt": "vp fmt && cargo fmt --manifest-path engine/Cargo.toml"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "vite-plus": "1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.3.12"
}
